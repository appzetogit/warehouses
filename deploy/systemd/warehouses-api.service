# systemd alternative to PM2 (use one or the other, not both).
# Single API process; systemd has no cluster mode. For several API processes,
# copy this unit to warehouses-api@.service, use PORT=%i, and list each port in
# the nginx upstream.
#
#   sudo cp deploy/systemd/*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now warehouses-api warehouses-socket warehouses-scheduler \
#        warehouses-worker@order warehouses-worker@tracking warehouses-worker@maintenance
[Unit]
Description=The Warehouses API
After=network-online.target mongod.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=warehouses
Group=warehouses
WorkingDirectory=/srv/warehouses/current/Backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=SOCKET_PORT=5001
Environment=SERVER_BACKGROUND_JOBS_ENABLED=false
Environment=SERVER_QUEUE_BOOTSTRAP_ENABLED=false
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/uploads

[Install]
WantedBy=multi-user.target
