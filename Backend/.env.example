# Copy to .env and fill in. Only the first block is needed to boot locally.

# --- Required ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/warehouses
JWT_ACCESS_SECRET=            # long random string
JWT_REFRESH_SECRET=           # a different long random string

# --- Brand ------------------------------------------------------------------
BRAND_NAME=Warehouses
BRAND_SUPPORT_EMAIL=
BRAND_NOTIFICATION_IMAGE=
FRONTEND_URL=http://localhost:5173
STORE_TIMEZONE=Asia/Kolkata

# --- Redis / queues (optional locally) --------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_ENABLED=false

# --- Payments ---------------------------------------------------------------
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=true

# --- Courier (Shiprocket). Unset, or SHIPPING_PROVIDER=mock, uses the mock. --
SHIPPING_PROVIDER=
SHIPROCKET_EMAIL=             # API user created in the Shiprocket panel
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=   # pickup nickname as set up in Shiprocket
SHIPROCKET_DEFAULT_PICKUP_PINCODE=

# --- AI assistant (Gemini) --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Push (Firebase) --------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- SMS / OTP --------------------------------------------------------------
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
USE_DEFAULT_OTP=false         # true only for local testing

# --- Maps -------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Deploy webhook ---------------------------------------------------------
DEPLOY_WEBHOOK_SECRET=
