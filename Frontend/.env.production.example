# Copy to .env.production before `npm run build` on the server or CI.
# NEVER use localhost values in production builds.

# API (required) — use your live domain
VITE_API_BASE_URL=https://example.com/api/v1

# Uploaded images served by nginx at /uploads/
VITE_UPLOAD_BASE_URL=https://example.com/uploads

# Brand name shown until business settings load, and in the page title
VITE_BRAND_NAME="The Warehouses"
